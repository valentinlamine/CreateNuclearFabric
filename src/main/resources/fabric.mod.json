{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.nuclearteam.createnuclear.CreateNuclear"
    ],
    "client": [
      "net.nuclearteam.createnuclear.CreateNuclearClient"
    ],
    "fabric-datagen": [
      "net.nuclearteam.createnuclear.infrastructure.data.CreateNuclearDatagen"
    ],
    "fabric-gametest": [
      "net.nuclearteam.createnuclear.gametest.DefaultHeatCalculatorGameTest",
      "net.nuclearteam.createnuclear.gametest.ReactorInputFluidManagerGameTest"
    ],
    "jei_mod_plugin": [
      "net.nuclearteam.createnuclear.compat.jei.CNJei"
    ],
    "rei_client": [
      "net.nuclearteam.createnuclear.compat.rei.CNRei"
    ],
    "emi": [
      "net.nuclearteam.createnuclear.compat.emi.CNEmi"
    ]
  },
  "mixins": [
    "createnuclear.mixins.json"
  ],
  "accessWidener": "createnuclear.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "create": ">=${create_version}",
    "forgeconfigapiport": ">=${forge_config_api_port_version}"
  },
  "suggests": {
    "jei": ">=${jei_version}",
    "roughlyenoughitems": ">=${rei_version}",
    "emi": ">=${emi_version}"
  }
}
